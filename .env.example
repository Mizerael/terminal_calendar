# Google OAuth credentials (Desktop app) — https://console.cloud.google.com/apis/credentials
# Copy this file to .env and fill in your values. Do not commit the real .env.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALENDAR_ID=primary
# Account to authorize with; optional. If unset, the app asks you in the terminal.
# GOOGLE_ACCOUNT=you@gmail.com
# GOOGLE_REDIRECT_URI=http://localhost:8765
# GOOGLE_TOKEN=token.json